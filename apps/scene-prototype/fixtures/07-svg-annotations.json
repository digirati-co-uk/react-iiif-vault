{
  "@context": "http://iiif.io/api/presentation/4/context.json",
  "id": "https://example.org/iiif/scene-panel/svg-annotations/manifest",
  "type": "Manifest",
  "label": { "en": ["3D SVG annotations with IIIF CSS styles"] },
  "items": [
    {
      "id": "https://example.org/iiif/scene-panel/svg-annotations/scene",
      "type": "Scene",
      "label": { "en": ["SVG annotation surfaces"] },
      "items": [
        {
          "id": "https://example.org/iiif/scene-panel/svg-annotations/paintings",
          "type": "AnnotationPage",
          "items": [
            {
              "id": "https://example.org/iiif/scene-panel/svg-annotations/model-painting",
              "type": "Annotation",
              "motivation": ["painting"],
              "body": {
                "id": "https://raw.githubusercontent.com/IIIF/3d/7bdd672cc97bead489ec71178b501d07c7b09c9d/assets/astronaut/astronaut.glb",
                "type": "Model",
                "format": "model/gltf-binary"
              },
              "target": { "id": "https://example.org/iiif/scene-panel/svg-annotations/scene", "type": "Scene" }
            },
            {
              "id": "https://example.org/iiif/scene-panel/svg-annotations/light-painting",
              "type": "Annotation",
              "motivation": ["painting"],
              "body": {
                "id": "https://example.org/iiif/scene-panel/svg-annotations/light",
                "type": "AmbientLight",
                "intensity": 1.3
              },
              "target": { "id": "https://example.org/iiif/scene-panel/svg-annotations/scene", "type": "Scene" }
            }
          ]
        }
      ],
      "annotations": [
        {
          "id": "https://example.org/iiif/scene-panel/svg-annotations/page",
          "type": "AnnotationPage",
          "items": [
            {
              "id": "https://example.org/iiif/scene-panel/svg-annotations/callout",
              "type": "Annotation",
              "motivation": ["commenting"],
              "label": { "en": ["SVG mission patch"] },
              "stylesheet": [
                {
                  "id": "https://example.org/iiif/scene-panel/svg-annotations/stylesheet",
                  "type": "CssStylesheet",
                  "value": ".mission-patch { background-color: #111827; opacity: 0.92; transform: rotate(-5deg); }"
                }
              ],
              "body": {
                "type": "TextualBody",
                "format": "text/html",
                "value": "<p><strong>Mission patch</strong></p><p>This SVG is a selectable surface positioned in the Scene. Its background, opacity, and transform come from an IIIF CSS stylesheet.</p>"
              },
              "target": {
                "type": "SpecificResource",
                "source": { "id": "https://example.org/iiif/scene-panel/svg-annotations/scene", "type": "Scene" },
                "styleClass": "mission-patch",
                "selector": [
                  {
                    "type": "PointSelector",
                    "x": -1.15,
                    "y": 2.6,
                    "z": 0.7,
                    "refinedBy": {
                      "type": "SvgSelector",
                      "value": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1.4 0.9\"><path d=\"M.7.03 1.35.27 1.23.78.7.88.17.78.05.27Z\" fill=\"#2563eb\" stroke=\"#f8fafc\" stroke-width=\".05\"/><path d=\"m.35.62.7-.38-.21.5-.14-.18-.14.18Z\" fill=\"#fbbf24\"/></svg>"
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
