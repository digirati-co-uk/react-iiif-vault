                  "format": "image/vnd.radiance"
                }
              },
              "target": { "id": "https://example.org/iiif/scene-panel/lights/scene", "type": "Scene" }
            },
            {
              "id": "https://example.org/iiif/scene-panel/lights/point-painting",
              "type": "Annotation",
              "motivation": ["painting"],
              "body": {
                "id": "https://example.org/iiif/scene-panel/lights/point",
                "type": "PointLight",
                "color": "#ff6b4a",
                "intensity": 2
              },
              "target": {
                "type": "SpecificResource",
                "source": { "id": "https://example.org/iiif/scene-panel/lights/scene", "type": "Scene" },
                "selector": [{ "type": "PointSelector", "x": -2, "y": 2.5, "z": 2 }]
              }
            },
            {
              "id": "https://example.org/iiif/scene-panel/lights/spot-painting",
              "type": "Annotation",
              "motivation": ["painting"],
              "body": {
                "id": "https://example.org/iiif/scene-panel/lights/spot",
                "type": "SpotLight",
                "color": "#6eb5ff",
                "intensity": 3,
                "angle": 24,
                "lookAt": { "id": "https://example.org/iiif/scene-panel/lights/model-painting", "type": "Annotation" }
              },
              "target": {
                "type": "SpecificResource",
                "source": { "id": "https://example.org/iiif/scene-panel/lights/scene", "type": "Scene" },
                "selector": [{ "type": "PointSelector", "x": 2, "y": 5, "z": 3 }]
