{
  "@context": "http://iiif.io/api/presentation/4/context.json",
  "id": "https://example.org/iiif/scene-panel/lights/manifest",
  "type": "Manifest",
  "label": { "en": ["All five Scene light types"] },
  "items": [
    {
      "id": "https://example.org/iiif/scene-panel/lights/scene",
      "type": "Scene",
      "label": { "en": ["Ambient, directional, image-based, point, and spot lights"] },
      "backgroundColor": "#151a22",
      "items": [
        {
          "id": "https://example.org/iiif/scene-panel/lights/page",
          "type": "AnnotationPage",
          "items": [
            {
              "id": "https://example.org/iiif/scene-panel/lights/model-painting",
              "type": "Annotation",
              "motivation": ["painting"],
              "body": {
                "id": "https://raw.githubusercontent.com/IIIF/3d/7bdd672cc97bead489ec71178b501d07c7b09c9d/assets/astronaut/astronaut.glb",
                "type": "Model",
                "format": "model/gltf-binary"
              },
              "target": { "id": "https://example.org/iiif/scene-panel/lights/scene", "type": "Scene" }
            },
            {
              "id": "https://example.org/iiif/scene-panel/lights/ambient-painting",
              "type": "Annotation",
              "motivation": ["painting"],
              "body": {
                "id": "https://example.org/iiif/scene-panel/lights/ambient",
                "type": "AmbientLight",
                "color": "#8aa4c8",
                "intensity": 0.25
              },
              "target": { "id": "https://example.org/iiif/scene-panel/lights/scene", "type": "Scene" }
            },
            {
              "id": "https://example.org/iiif/scene-panel/lights/directional-painting",
              "type": "Annotation",
              "motivation": ["painting"],
              "body": {
                "id": "https://example.org/iiif/scene-panel/lights/directional",
                "type": "DirectionalLight",
                "color": "#ffffff",
                "intensity": 1.1,
                "lookAt": { "id": "https://example.org/iiif/scene-panel/lights/model-painting", "type": "Annotation" }
              },
              "target": {
                "type": "SpecificResource",
                "source": { "id": "https://example.org/iiif/scene-panel/lights/scene", "type": "Scene" },
                "selector": [{ "type": "PointSelector", "x": 4, "y": 6, "z": 5 }]
              }
            },
            {
              "id": "https://example.org/iiif/scene-panel/lights/ibl-painting",
              "type": "Annotation",
              "motivation": ["painting"],
              "body": {
                "id": "https://example.org/iiif/scene-panel/lights/ibl",
                "type": "ImageBasedLight",
                "intensity": 0.45,
                "environmentMap": {
                  "id": "https://raw.githubusercontent.com/mrdoob/three.js/r177/examples/textures/equirectangular/royal_esplanade_1k.hdr",
