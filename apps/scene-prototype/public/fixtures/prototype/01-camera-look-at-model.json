          "items": [
            {
              "id": "https://example.org/iiif/scene-panel/camera-look-at/model-painting",
              "type": "Annotation",
              "motivation": ["painting"],
              "body": {
                "id": "https://raw.githubusercontent.com/IIIF/3d/7bdd672cc97bead489ec71178b501d07c7b09c9d/assets/astronaut/astronaut.glb",
                "type": "Model",
