                "selector": [{ "type": "PointSelector", "x": 0, "y": 2.1, "z": 8 }]
              }
            },
            {
              "id": "https://example.org/iiif/scene-panel/camera-look-at/ambient-painting",
              "type": "Annotation",
              "motivation": ["painting"],
              "body": {
                "id": "https://example.org/iiif/scene-panel/camera-look-at/ambient",
                "type": "AmbientLight",
                "color": "#d8e8ff",
                "intensity": 0.55
              },
              "target": { "id": "https://example.org/iiif/scene-panel/camera-look-at/scene", "type": "Scene" }
            },
            {
              "id": "https://example.org/iiif/scene-panel/camera-look-at/key-painting",
              "type": "Annotation",
              "motivation": ["painting"],
              "body": {
                "id": "https://example.org/iiif/scene-panel/camera-look-at/key",
                "type": "DirectionalLight",
                "color": "#ffffff",
                "intensity": 1.4,
                "lookAt": {
                  "id": "https://example.org/iiif/scene-panel/camera-look-at/model-painting",
                  "type": "Annotation"
                }
              },
              "target": {
                "type": "SpecificResource",
                "source": { "id": "https://example.org/iiif/scene-panel/camera-look-at/scene", "type": "Scene" },
                "selector": [{ "type": "PointSelector", "x": 4, "y": 6, "z": 6 }]
              }
            }
          ]
        }
      ],
      "annotations": [
        {
          "id": "https://example.org/iiif/scene-panel/camera-look-at/comments",
