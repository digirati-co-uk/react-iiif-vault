            {
              "id": "https://example.org/iiif/scene-panel/camera-look-at/camera-painting",
              "type": "Annotation",
              "motivation": ["painting"],
              "body": {
                "id": "https://example.org/iiif/scene-panel/camera-look-at/camera",
