{
  "@context": "http://iiif.io/api/presentation/4/context.json",
  "id": "https://example.org/iiif/scene-panel/camera-look-at/manifest",
  "type": "Manifest",
  "label": { "en": ["Corrected camera looking at model bounds"] },
  "summary": {
    "en": ["The initial camera is positioned before paint and looks at the center of the astronaut's rendered bounds."]
  },
  "items": [
    {
      "id": "https://example.org/iiif/scene-panel/camera-look-at/scene",
      "type": "Scene",
      "label": { "en": ["Camera lookAt model bounds"] },
