{
  "@context": "http://iiif.io/api/presentation/4/context.json",
  "id": "https://example.org/iiif/scene-panel/audio/manifest",
  "type": "Manifest",
  "label": { "en": ["All three Scene audio emitters"] },
  "items": [
    {
      "id": "https://example.org/iiif/scene-panel/audio/scene",
      "type": "Scene",
      "label": { "en": ["Ambient, point, and spot audio"] },
      "duration": 12,
      "backgroundColor": "#181b20",
      "items": [
        {
          "id": "https://example.org/iiif/scene-panel/audio/page",
          "type": "AnnotationPage",
          "items": [
            {
              "id": "https://example.org/iiif/scene-panel/audio/model-painting",
              "type": "Annotation",
              "motivation": ["painting"],
              "body": {
                "id": "https://raw.githubusercontent.com/IIIF/3d/7bdd672cc97bead489ec71178b501d07c7b09c9d/assets/astronaut/astronaut.glb",
                "type": "Model",
                "format": "model/gltf-binary"
              },
              "target": { "id": "https://example.org/iiif/scene-panel/audio/scene", "type": "Scene" }
            },
            {
              "id": "https://example.org/iiif/scene-panel/audio/ambient-painting",
              "type": "Annotation",
              "motivation": ["painting"],
              "timeMode": "loop",
              "body": {
                "id": "https://example.org/iiif/scene-panel/audio/ambient",
                "type": "AmbientAudio",
                "source": {
                  "id": "https://raw.githubusercontent.com/mrdoob/three.js/r185/examples/sounds/358232_j_s_song.ogg",
                  "type": "Audio",
                  "format": "audio/ogg"
                },
                "volume": 0.18
              },
              "target": {
                "type": "SpecificResource",
                "source": { "id": "https://example.org/iiif/scene-panel/audio/scene", "type": "Scene" },
                "selector": [{ "type": "FragmentSelector", "value": "t=0,12" }]
              }
            },
            {
              "id": "https://example.org/iiif/scene-panel/audio/point-painting",
              "type": "Annotation",
              "motivation": ["painting"],
              "timeMode": "trim",
              "body": {
                "id": "https://example.org/iiif/scene-panel/audio/point",
                "type": "PointAudio",
                "source": {
                  "id": "https://raw.githubusercontent.com/mrdoob/three.js/r185/examples/sounds/358232_j_s_song.ogg",
                  "type": "Audio",
                  "format": "audio/ogg"
                },
                "volume": 0.35
              },
              "target": {
                "type": "SpecificResource",
                "source": { "id": "https://example.org/iiif/scene-panel/audio/scene", "type": "Scene" },
                "selector": [
                  {
                    "type": "PointSelector",
                    "x": -2,
                    "y": 1.5,
                    "z": 0,
                    "refinedBy": { "type": "FragmentSelector", "value": "t=2,10" }
                  }
                ]
              }
            },
            {
              "id": "https://example.org/iiif/scene-panel/audio/spot-painting",
              "type": "Annotation",
              "motivation": ["painting"],
              "timeMode": "scale",
              "body": {
                "id": "https://example.org/iiif/scene-panel/audio/spot",
                "type": "SpotAudio",
                "source": {
                  "id": "https://raw.githubusercontent.com/mrdoob/three.js/r185/examples/sounds/358232_j_s_song.ogg",
                  "type": "Audio",
                  "format": "audio/ogg"
                },
                "volume": 0.35,
                "angle": 30,
                "lookAt": {
                  "type": "SpecificResource",
                  "source": { "id": "https://example.org/iiif/scene-panel/audio/scene", "type": "Scene" },
                  "selector": [{ "type": "PointSelector", "x": 0, "y": 2, "z": 0 }]
                }
              },
              "target": {
                "type": "SpecificResource",
                "source": { "id": "https://example.org/iiif/scene-panel/audio/scene", "type": "Scene" },
                "selector": [
                  {
                    "type": "PointSelector",
                    "x": 2,
                    "y": 2,
                    "z": 2,
                    "refinedBy": { "type": "FragmentSelector", "value": "t=1,11" }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
