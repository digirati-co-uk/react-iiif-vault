{
  "name": "react-iiif-vault",
  "version": "4.0.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "web": "dist/bundle.global.js",
  "repository": {
    "type": "git",
