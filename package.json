  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./presentation-4": {
      "require": {
        "types": "./dist/presentation-4.d.cts",
        "default": "./dist/presentation-4.cjs"
      },
      "import": {
        "types": "./dist/presentation-4.d.ts",
        "default": "./dist/presentation-4.js"
      }
    },
    "./helpers": {
      "require": {
        "types": "./dist/helpers.d.cts",
        "default": "./dist/helpers.cjs"
      },
      "import": {
        "types": "./dist/helpers.d.ts",
        "default": "./dist/helpers.js"
      }
    },
    "./presentation-4/helpers": {
      "require": {
        "types": "./dist/presentation-4/helpers.d.cts",
        "default": "./dist/presentation-4/helpers.cjs"
      },
      "import": {
        "types": "./dist/presentation-4/helpers.d.ts",
        "default": "./dist/presentation-4/helpers.js"
      }
    },
    "./canvas-panel": {
      "require": {
        "types": "./dist/canvas-panel.d.cts",
        "default": "./dist/canvas-panel.cjs"
      },
      "import": {
        "types": "./dist/canvas-panel.d.ts",
        "default": "./dist/canvas-panel.js"
      }
    },
    "./scene-panel": {
      "require": {
        "types": "./dist/scene-panel.d.cts",
        "default": "./dist/scene-panel.cjs"
      },
      "import": {
        "types": "./dist/scene-panel.d.ts",
        "default": "./dist/scene-panel.js"
      }
    },
    "./scene-panel.css": "./dist/scene-panel.css",
    "./waveform": {
      "require": {
        "types": "./dist/waveform.d.cts",
        "default": "./dist/waveform.cjs"
      },
      "import": {
        "types": "./dist/waveform.d.ts",
        "default": "./dist/waveform.js"
      }
    },
    "./waveform.css": "./dist/waveform.css",
    "./utils": {
      "require": {
        "types": "./dist/utils.d.cts",
        "default": "./dist/utils.cjs"
      },
      "import": {
        "types": "./dist/utils.d.ts",
        "default": "./dist/utils.js"
      }
    }
  },
  "scripts": {
    "build": "tsup && tsup --config tsup.umd.ts && cp src/scene-panel/scene-panel.css src/waveform/waveform.css dist/",
    "demo:build": "pnpm --dir apps/scene-prototype fixtures:sync && vite build",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:package": "node scripts/check-package.mjs",
    "prepack": "pnpm build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:pkg": "publint",
    "prestart": "pnpm --dir apps/scene-prototype fixtures:sync",
    "start": "vite"
  },
  "license": "MIT",
  "dependencies": {
    "@floating-ui/react": "^0.27.13",
    "@iiif/helpers": "4.0.0",
